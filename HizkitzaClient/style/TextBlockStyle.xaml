<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style TargetType="TextBlock" x:Key="Text.Basic">
        <Setter Property="FontFamily" Value="{StaticResource Font.Workbench.Evenly}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="Text.Title" BasedOn="{StaticResource Text.Basic}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sixtyfour.Evenly}"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="Text.Small" BasedOn="{StaticResource Text.Basic}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Workbench.Slight}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="Text.Basic.Negative" BasedOn="{StaticResource Text.Basic}">
        <Setter Property="Foreground" Value="Pink"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="Text.Small.Negative" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="Pink"/>
    </Style>
    
</ResourceDictionary>