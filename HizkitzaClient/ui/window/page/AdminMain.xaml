<Page x:Class="HizkitzaClient.ui.window.page.AdminMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HizkitzaClient.ui.window.page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminMain">

    <Grid Margin="50,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Button Content="Erabiltzaileak" Margin="0,10,0,0"/>
            <Button Content="*Partidak ikusi" Margin="0,10,0,0"/>
            <StackPanel Margin="40,20,40,-10">
                <TextBlock Text="Informeak:" Style="{StaticResource Text.Basic}"/>
                <ComboBox Margin="0,0,0,5"/>
            </StackPanel>
            <Button Content="Informea jaitsi" Margin="0,10,0,0"/>
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Zerbitzaria:" DockPanel.Dock="Top" Style="{StaticResource Text.Basic}"/>
            <DockPanel DockPanel.Dock="Bottom">
                <Button Click="Bidali_Click" DockPanel.Dock="Right" Content="Bidali"/>
                <TextBox x:Name="command" KeyDown="Command_KeyDown" Style="{StaticResource TextBox.Medium}" VerticalContentAlignment="Center" Width="auto"/>
            </DockPanel>
            <ListBox x:Name="logs" ItemsSource="{Binding Logs}" Margin="0,0,0,10"/>
        </DockPanel>
        
    </Grid>
</Page>
