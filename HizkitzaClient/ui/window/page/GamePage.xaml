<Page x:Class="HizkitzaClient.ui.window.page.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HizkitzaClient.ui.window.page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage">

    <Grid Margin="50,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="1" Margin="10">
            <DockPanel DockPanel.Dock="Top">
                <TextBlock x:Name="itxura" Style="{StaticResource Text.Basic}" DockPanel.Dock="Right"/>
                <TextBlock x:Name="partidaIzena" Style="{StaticResource Text.Basic}"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom">
                <Button Click="Bidali_Click" DockPanel.Dock="Right" Content="Bidali" Width="100"/>
                <TextBox x:Name="command" KeyDown="Message_KeyDown" Style="{StaticResource TextBox.Medium}" VerticalContentAlignment="Center" Width="auto"/>
            </DockPanel>
            <ListBox x:Name="messages" ItemsSource="{Binding Logs}" Margin="0,0,0,10"/>
        </DockPanel>
    </Grid>
</Page>
