<Window x:Class="HizkitzaClient.ui.messagebox.HizkitzaBooleanMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HizkitzaClient.ui.messagebox"
        mc:Ignorable="d"
        Height="150" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        BorderThickness="2"
        BorderBrush="White"
        Background="Black"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mezua -->
        <TextBlock Grid.Row="0"
                   VerticalAlignment="Center"
                   Margin="30,10"
                   Text="{Binding Message}" 
                   Style="{StaticResource Text.Basic}"/>

        <!-- Botoiak -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button Content="{Binding PositiveText}" Margin="0,0,10,0"
                    Style="{StaticResource Button.Positive}"
                    Command="{Binding AcceptCommand}"/>
            <Button Content="{Binding NegativeText}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource Button.Negative}"/>
        </StackPanel>
    </Grid>
</Window>
