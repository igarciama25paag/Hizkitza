<Window x:Class="HizkitzaClient.ui.messagebox.HizkitzaDownloadMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        BorderThickness="2"
        BorderBrush="White"
        Background="Black"
        ResizeMode="NoResize">

    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">

            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Message}"
                       Style="{StaticResource Text.Basic}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="downBytes" 
                       Margin="0,10,0,0"
                       DockPanel.Dock="Top"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Basic}"/>

            <Border>
                <TextBlock x:Name="progressBar"
                           Padding="5"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Basic.Positive}"
                           TextWrapping="Wrap"/>
            </Border>
            <Button Click="Cancel_Click" Content="Cancel" Margin="0,10,0,0" Style="{StaticResource Button.Negative}"/>
        </StackPanel>
    </Grid>
</Window>
